#!/bin/sh
# Conventional Commits, because the release pipeline derives the version and the
# changelog from these subjects. A malformed subject is a broken release.
set -e

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Allow merge, revert and fixup subjects through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert)(\([a-z0-9._/-]+\))?(!)?: .{1,90}$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'MSG'
[commit-msg] rejected: subject is not a Conventional Commit.

  <type>[(scope)][!]: <description>

  type   feat fix perf refactor docs test build ci chore style revert
  scope  optional, lower-kebab, e.g. (core) (desktop) (solver)
  !      marks a breaking change
  desc   imperative mood, no trailing full stop, <= 90 chars

  examples
    feat(solver): add bounded displacement pass
    fix(desktop)!: drop the legacy holidays field from saved projects
MSG
  exit 1
fi
exit 0
