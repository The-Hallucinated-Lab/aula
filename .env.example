# ---------------------------------------------------------------------------
# Aula — environment contract
#
# Every variable below is optional and has a working default; Aula runs with no
# .env file at all. Copy this file to `.env` only to override a default.
#
# The values are read and validated once, at main-process start
# (apps/desktop/electron/config/env.ts). An invalid value aborts the launch
# with a named error rather than degrading silently at the point of use.
#
# Nothing here is a secret. Aula holds no credentials: it has no server, no
# database and no third-party account. The only network destination it will
# ever contact is the local assistant endpoint below.
# ---------------------------------------------------------------------------

# --- Local assistant (optional; Ollama or any Ollama-compatible server) ------

# Base URL of the local model server. Must be http/https and must resolve to a
# loopback host — Aula refuses a remote address so institutional data cannot be
# pointed at a third party by editing a config file.
AULA_ASSISTANT_BASE_URL=http://127.0.0.1:11434

# Milliseconds to wait when probing whether the assistant is up.
# Integer, 250–30000.
AULA_ASSISTANT_TIMEOUT_MS=2500

# Context window requested per chat call. Integer, 512–131072.
# Raising this past what the local GPU can hold makes the server return 500.
AULA_ASSISTANT_NUM_CTX=8192

# Sampling temperature for assistant replies. Float, 0–2.
AULA_ASSISTANT_TEMPERATURE=0.2

# Set to 1 to compile the assistant out of the running app entirely: the probe
# always reports unavailable and the relay refuses every request.
AULA_ASSISTANT_DISABLED=0

# --- Diagnostics -------------------------------------------------------------

# error | warn | info | debug
AULA_LOG_LEVEL=info

# Opt-in crash and error reporting. Empty disables telemetry completely, which
# is the default. See docs/ARCHITECTURE.md for what is and is not collected.
AULA_TELEMETRY_DSN=

# --- Injected by tooling (do not set by hand) --------------------------------

# vite-plugin-electron sets this in development so the main process loads the
# dev server instead of the built files. Its presence is what `isDev` means.
# VITE_DEV_SERVER_URL=
